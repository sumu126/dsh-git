{
  "name": "dsh-git",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Git repositories of a DSH workspace: a right-sidebar panel that lists the checkouts under a root, and tools for status, history, diffs, branches, staging, commits, and switching — all on the local command line, all bounded.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sumu126/dsh-git.git"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-tool"
      ]
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build-host.mjs && node scripts/build-client.mjs",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.types.json",
    "test": "node --import tsx/esm --test tests/parse.test.ts",
    "test:live": "node --import tsx/esm --test tests/git-live.test.ts",
    "verify:host": "node --import tsx/esm scripts/verify-host.mjs",
    "verify:client": "node --import tsx/esm scripts/verify-client.mjs",
    "verify:cards": "node --import tsx/esm scripts/verify-cards.mjs",
    "verify:loader": "node --import tsx/esm tests/loader-smoke.mjs",
    "verify:desktop": "node scripts/verify-desktop.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/schemastery": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-client-store": "*",
    "@deepseek-ai/dsh-client-ui-slots": "*",
    "@deepseek-ai/dsh-client-ui-primitives": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/schemastery": { "optional": true },
    "@deepseek-ai/dsh-tools": { "optional": true },
    "@deepseek-ai/dsh-client-store": { "optional": true },
    "@deepseek-ai/dsh-client-ui-slots": { "optional": true },
    "@deepseek-ai/dsh-client-ui-primitives": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/react": "^18.3.31",
    "esbuild": "^0.25.0",
    "lightningcss": "^1.32.0",
    "react": "^18.3.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
